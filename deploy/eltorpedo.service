[Unit]
Description=eltorpedo ROV control TUI
After=mavlink-router.service
Requires=mavlink-router.service

[Service]
Type=simple
User=eltorpedo
WorkingDirectory=/opt/eltorpedo
Environment=TERM=linux
ExecStart=/opt/eltorpedo/.venv/bin/eltorpedo --config /opt/eltorpedo/config.toml
# A TUI needs a terminal. This unit takes over the local console tty1.
StandardInput=tty-force
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=no

[Install]
WantedBy=multi-user.target
